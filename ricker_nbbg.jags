model {

    # Priors (lognormal)
    lnR ~ dnorm(log(1), 2/3)  #mean and precision (1/var)
    lnalpha ~ dnorm(log(0.001), 0.5)
    # R ~ dunif(0,25) #trying more informative distributions: says no large values
    # alpha ~ dunif(0,0.01)
    lnkD ~ dnorm(log(10), 0.5)
    lnkE ~ dnorm(log(10), 0.5)

    # Transformed parameters
    R <- exp(lnR)
    alpha <- exp(lnalpha)
    kD <- exp(lnkD)
    kE <- exp(lnkE)

    # Fixed parameter
    p_fem = 0.5

    # Likelihood
    for ( i in 1:n ) {

        # Mirrors the model code for DGP
        # but parameterization is different for distributions

        # Heterogeneity in sex
        females[i] ~ dbin(p_fem, Nt[i])
        has_fem[i] <- step(females[i] - 0.5) #indicator variable, 0 or 1

        # Environmental stochasticity
        Rtx[i] ~ dgamma(kE, kE / R)

        # Negative binomial births + density independent mortality
#        r_nb[i] <- kD * females[i] + equals(females[i], 0)
#        mu_nb[i] <- (1/p_fem) * females[i] * Rtx[i]
#        q_nb[i] <- r_nb[i] / (r_nb[i] + mu_nb[i])
#        births[i] ~ dnegbin(q_nb[i], r_nb[i])

#        r_nb[i] <- kD * females[i] + 1e-6
#        mu_nb[i] <- (1 / p_fem) * females[i] * Rtx[i] + 1e-6
#        lambda[i] ~ dgamma(r_nb[i], r_nb[i] / mu_nb[i])
#        births[i] ~ dpois(lambda[i])

        r_nb[i] <- kD * females[i]
        mu_nb[i] <- (Rtx[i] / p_fem) * females[i]

        # Gamma-Poisson only when females > 0

        lambda_birth[i] ~ dgamma( r_nb[i] * has_fem[i] + (1 - has_fem[i]),
            (r_nb[i] * has_fem[i] + (1 - has_fem[i])) / 
            (mu_nb[i] * has_fem[i] + (1 - has_fem[i]))
        )
        births_mean[i] <- has_fem[i] * lambda_birth[i]
        births[i] ~ dpois(births_mean[i])

        # Density dependent survival
        survprob[i] <- exp(-alpha * Nt[i])
        Ntp1[i] ~ dbin(survprob[i], births[i])
    }
}
